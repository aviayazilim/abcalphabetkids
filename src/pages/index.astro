---
// Static hosting can't redirect by Accept-Language, so the root is a plain
// language picker and doubles as the hreflang x-default.
import '../styles/global.css';
import { SITE } from '../site';
import { t } from '../i18n';
import { LANGS, HREFLANG, path } from '../lib/routes';
import { DEFAULT_LANGS } from '../lib/lang-order';
import LangOrderScript from '../components/LangOrderScript.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ABC Alphabet — choose your language</title>
  <meta name="description" content="ABC Alphabet: alphabet app for kids aged 3–6 and free printable letter tracing worksheets. Азбука и прописи · ABC-App und Arbeitsblätter." />
  <link rel="canonical" href={SITE.url + '/'} />
  {LANGS.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={SITE.url + path.home(l)} />)}
  <link rel="alternate" hreflang="x-default" href={SITE.url + '/'} />
  <meta name="apple-itunes-app" content={`app-id=${SITE.appStoreId}`} />
  {SITE.pinterestVerify && <meta name="p:domain_verify" content={SITE.pinterestVerify} />}
  <meta property="og:image" content={SITE.url + '/og/default.png'} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <main class="picker wrap">
    <img src="/img/icon.webp" alt="ABC Alphabet" width="96" height="96" />
    <h1>ABC Alphabet</h1>
    <ul data-lang-order>
      {DEFAULT_LANGS.map((l) => (
        <li data-lang={l}><a href={path.home(l)} hreflang={l} lang={l} data-lang={l}><img src={`/img/flags/${l}.webp`} alt="" width="40" height="40" />{t(l).langName}</a></li>
      ))}
    </ul>
  </main>
  <LangOrderScript />
  <script is:inline define:vars={{ have: [...LANGS] }}>
    // Same order as the app (SceneDelegate.setDefaultLanguage): a language the
    // visitor picked before, else the device's primary language, else English.
    // Only this root page redirects — language URLs themselves never do.
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('lang'); } catch (e) {}
      var primary = ((navigator.languages && navigator.languages[0]) || navigator.language || '').slice(0, 2).toLowerCase();
      var target = [saved, primary, 'en'].filter(function (l) { return l && have.indexOf(l) >= 0; })[0];
      if (target) location.replace('/' + target + '/');
    })();
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[data-lang]');
      if (a) try { localStorage.setItem('lang', a.dataset.lang); } catch (err) {}
    });
  </script>
</body>
</html>
<style>
  .picker { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 8px; }
  .picker > img { border-radius: 24px; }
  ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 12px; width: min(320px, 100%); }
  li a { display: flex; align-items: center; gap: 14px; padding: 12px 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); color: var(--ink); text-decoration: none; font-weight: 800; font-size: 1.15rem; }
  li a:hover { border-color: var(--ink); }
  li img { border-radius: 50%; }
</style>
