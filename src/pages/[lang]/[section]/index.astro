---
import fs from 'node:fs';
import Base from '../../../layouts/Base.astro';
import StoreButtons from '../../../components/StoreButtons.astro';
import LetterTile from '../../../components/LetterTile.astro';
import AppBlock from '../../../components/AppBlock.astro';
import { appStoreUrl, playUrl } from '../../../site';
import { t } from '../../../i18n';
import { LANGS, SECTIONS, LETTERS, PAPER, PAPER_LABEL, articlesIn, wordsFor, path, type Lang, type SectionKind } from '../../../lib/routes';
import { WORDS_COPY } from '../../../i18n/words';
import { NAME_COPY } from '../../../i18n/name';
import NameTracer from '../../../components/NameTracer.astro';
import NameCard from '../../../components/NameCard.astro';
import { NAMECARD_COPY } from '../../../i18n/namecard';
import languages from '../../../../data/languages.json';
import QRCode from 'qrcode';
import { SITE } from '../../../site';
import { tileStyle, tint, inkOn } from '../../../lib/color';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    Object.entries(SECTIONS[lang])
      .filter(([kind]) => kind !== 'articles' || articlesIn(lang).length > 0)
      .filter(([kind]) => kind !== 'words' || WORDS_COPY[lang])
      .map(([kind, section]) => ({ params: { lang, section }, props: { kind } })),
  );
}

const lang = Astro.params.lang as Lang;
const kind = Astro.props.kind as SectionKind;
const tr = t(lang);
const letters = LETTERS[lang];
const bySymbol = new Map(letters.map((l) => [l.letter, l]));

// QR codes on the sheets and Pinterest pins land on the app page with ?c=…;
// only these known campaigns are honoured.
const redirects = {
  pdf: { ios: appStoreUrl(`pdf_${lang}`), android: playUrl(`pdf_${lang}`, 'pdf') },
  pinterest: { ios: appStoreUrl(`pinterest_${lang}`), android: playUrl(`pinterest_${lang}`, 'pinterest') },
  name: { ios: appStoreUrl(`name_${lang}`), android: playUrl(`name_${lang}`, 'name') },
};
const W = WORDS_COPY[lang];
const NC = NAME_COPY[lang];
const nameData = kind === 'name' ? {
  sheet: (languages as Record<string, { sheet: { name: string; date: string; qr: string; scan: string } }>)[lang].sheet,
  letters: letters.map((l) => ({ letter: l.letter, img: l.character ?? l.characterImage, color: l.color })),
  qrSvg: await QRCode.toString(`${SITE.url}/${lang}/${SECTIONS[lang].app}/?c=name`, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1f2330', light: '#ffffff' } }),
} : null;
const NK = NAMECARD_COPY[lang];
// Every alphabet, so the card can be built with any language's characters; this page's language first.
const cardAlphabets = kind === 'namecard' ? [lang, ...LANGS.filter((x) => x !== lang)].map((code) => ({
  code, name: t(code).langName, sample: NAME_COPY[code].placeholder,
  letters: LETTERS[code].map((l) => ({ letter: l.letter, img: l.character ?? l.characterImage, bg: tint(l.color), ink: inkOn(l.color) })),
})) : [];
const cardJsonLd = kind === 'namecard' ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: NK.h1, description: NK.description, url: new URL(path.section(lang, 'namecard')!, SITE.url).href,
      applicationCategory: 'EducationalApplication', operatingSystem: 'Any', inLanguage: lang, isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@type': 'FAQPage', mainEntity: NK.faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) },
  ],
} : null;
const nameJsonLd = kind === 'name' ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: NC.h1, description: NC.description, url: new URL(path.section(lang, 'name')!, SITE.url).href,
      applicationCategory: 'EducationalApplication', operatingSystem: 'Any', inLanguage: lang, isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@type': 'FAQPage', mainEntity: NC.faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) },
  ],
} : null;
const wordLetters = kind === 'words' ? letters.filter((l) => wordsFor(lang, l.slug)) : [];
const tracingGuide = articlesIn(lang).find((a) => a.topic === 'tracing-guide');
const articles = kind === 'articles' ? articlesIn(lang) : [];
const dateFmt = new Intl.DateTimeFormat(tr.locale.replace('_', '-'), { dateStyle: 'long' });
const content = kind === 'privacy' ? tr.privacy : kind === 'imprint' ? tr.imprint! : null;
const screens = kind === 'app'
  ? (fs.existsSync(`public/img/screens/${lang}`) ? fs.readdirSync(`public/img/screens/${lang}`) : []).filter((f) => f.endsWith('-360.webp')).sort().map((f) => f.replace('-360.webp', ''))
  : [];
---
{kind === 'tracing' && (
  <Base lang={lang} title={tr.tracing.title} description={tr.tracing.description} page={{ kind }} nav="tracing">
    <section class="section">
      <div class="wrap">
        <h1>{tr.tracing.h1}</h1>
        <p class="lead">{tr.tracing.lead}</p>
        <div class="dl">
          <a class="btn" href={path.pdfAll(lang, PAPER[lang][0])} download>{tr.tracing.downloadAll}</a>
          {PAPER[lang].slice(1).map((size) => <a class="btn btn-quiet" href={path.pdfAll(lang, size)} download>{PAPER_LABEL[size]}</a>)}
        </div>
        <div class="more-tools">
          {W && path.section(lang, 'words') && <a class="btn btn-quiet" href={path.section(lang, 'words')!}>{W.hubLink} →</a>}
          {path.section(lang, 'name') && <a class="btn btn-quiet" href={path.section(lang, 'name')!}>{NC.card.title} →</a>}
          {path.section(lang, 'namecard') && <a class="btn btn-quiet" href={path.section(lang, 'namecard')!}>{NK.link} →</a>}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <h2>{tr.tracing.gridTitle}</h2>
        <div class="grid letters">
          {letters.map((l) => <LetterTile letter={l} href={path.letter(lang, l.slug)} alt={tr.letter.characterAlt(l)} />)}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <h2>{tr.tracing.setsTitle}</h2>
        <div class="grid sets">
          {tr.tracing.sets.map((s) => (
            <div class="card">
              <h3>{s.title}</h3>
              <p class="set-letters">
                {s.letters.map((x) => bySymbol.get(x)).filter(Boolean).map((l) => (
                  <a href={path.letter(lang, l!.slug)} style={tileStyle(l!.color)}>{l!.letter}</a>
                ))}
              </p>
              <p class="muted">{s.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap prose">
        <h2>{tr.tracing.guideTitle}</h2>
        <Fragment set:html={tr.tracing.guide} />
        {tracingGuide && <p><a href={path.article(lang, tracingGuide.slug)}><b>{tr.articles.guideLink}: {tracingGuide.h1}</b></a></p>}
        {W && path.section(lang, 'words') && <p><a href={path.section(lang, 'words')!}><b>{W.hubLink} →</b></a></p>}
        {path.section(lang, 'name') && <p><a href={path.section(lang, 'name')!}><b>{NC.hubLink} →</b></a></p>}
      </div>
    </section>
    <section class="section">
      <div class="wrap"><AppBlock lang={lang} campaign={`site_${lang}_tracing`} /></div>
    </section>
  </Base>
)}

{kind === 'coloring' && tr.coloring && (
  <Base lang={lang} title={tr.coloring.title} description={tr.coloring.description} page={{ kind }} nav="coloring">
    <section class="section">
      <div class="wrap">
        <h1>{tr.coloring.h1}</h1>
        <p class="lead">{tr.coloring.lead}</p>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <h2>{tr.coloring.gridTitle}</h2>
        <ul class="coloring-grid">
          {letters.filter((l) => l.coloring).map((l) => {
            const preview = `/img/coloring/${lang}/${l.slug}.webp`;
            return (
              <li>
                <a class="card" href={path.coloringLetter(lang, l.slug)!}>
                  {fs.existsSync('public' + preview)
                    ? <img src={preview} alt={tr.coloring!.previewAlt(l)} width="595" height="842" loading="lazy" decoding="async" />
                    : <span class="ph" style={tileStyle(l.color)}>{l.letter}</span>}
                  <span><b>{l.letter}</b> · {l.word}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
    <section class="section">
      <div class="wrap"><AppBlock lang={lang} campaign={`site_${lang}_coloring`} /></div>
    </section>
  </Base>
)}

{kind === 'namecard' && (
  <Base lang={lang} title={NK.title} description={NK.description} page={{ kind }}>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(cardJsonLd)} />
    <section class="section">
      <div class="wrap">
        <h1>{NK.h1}</h1>
        <p class="lead">{NK.lead}</p>
        <NameCard lang={lang} copy={NK} nameLabel={NC.nameLabel} placeholder={NC.placeholder} errEmpty={NC.errEmpty} errInvalid={NC.errInvalid} privacy={NK.privacy} alphabets={cardAlphabets} />
      </div>
    </section>
    <section class="section">
      <div class="wrap prose">
        <h2>{NK.ideasTitle}</h2>
        <ul>{NK.ideas.map((x) => <li>{x}</li>)}</ul>
        <h2>{NK.faqTitle}</h2>
        {NK.faq.map((x) => (
          <details class="faq">
            <summary>{x.q}</summary>
            <p>{x.a}</p>
          </details>
        ))}
        <p><a href={path.section(lang, 'name')!}><b>{NC.card.title} →</b></a> · <a href={path.section(lang, 'tracing')!}><b>{tr.nav.tracing} →</b></a></p>
      </div>
    </section>
    <section class="section">
      <div class="wrap"><AppBlock lang={lang} campaign={`site_${lang}_namecard`} /></div>
    </section>
  </Base>
)}

{kind === 'name' && nameData && (
  <Base lang={lang} title={NC.title} description={NC.description} page={{ kind }}>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(nameJsonLd)} />
    <section class="section">
      <div class="wrap">
        <h1>{NC.h1}</h1>
        <p class="lead">{NC.lead}</p>
        <NameTracer lang={lang} copy={NC} sheet={nameData.sheet} letters={nameData.letters} qrSvg={nameData.qrSvg} paper={PAPER[lang]} />
      </div>
    </section>
    <section class="section">
      <div class="wrap prose">
        <h2>{NC.guideTitle}</h2>
        <Fragment set:html={NC.guide} />
        <h2>{NC.faqTitle}</h2>
        {NC.faq.map((x) => (
          <details class="faq">
            <summary>{x.q}</summary>
            <p>{x.a}</p>
          </details>
        ))}
        <p><a href={path.section(lang, 'namecard')!}><b>{NK.link} →</b></a> · <a href={path.section(lang, 'tracing')!}><b>{tr.nav.tracing} →</b></a></p>
      </div>
    </section>
    <section class="section">
      <div class="wrap"><AppBlock lang={lang} campaign={`site_${lang}_name`} /></div>
    </section>
  </Base>
)}

{kind === 'words' && W && (
  <Base lang={lang} title={W.title} description={W.description} page={{ kind }} nav="words">
    <section class="section">
      <div class="wrap">
        <h1>{W.h1}</h1>
        <p class="lead">{W.lead}</p>
        <h2>{W.gridTitle}</h2>
        <div class="grid letters">
          {wordLetters.map((l) => <LetterTile letter={l} href={path.wordsLetter(lang, l.slug)!} alt={tr.letter.characterAlt(l)} />)}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap"><AppBlock lang={lang} campaign={`site_${lang}_words`} /></div>
    </section>
  </Base>
)}

{kind === 'articles' && (
  <Base lang={lang} title={tr.articles.title} description={tr.articles.description} page={{ kind }} nav="articles">
    <section class="section">
      <div class="wrap">
        <h1>{tr.articles.h1}</h1>
        <p class="lead">{tr.articles.lead}</p>
        <ul class="article-list">
          {articles.map((a) => (
            <li class="card">
              <h2 class="h3"><a href={path.article(lang, a.slug)}>{a.h1}</a></h2>
              <p class="muted">{a.lead}</p>
              <p class="meta"><time datetime={a.date}>{dateFmt.format(new Date(a.date))}</time> · <a href={path.article(lang, a.slug)}>{tr.articles.readMore} →</a></p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="section">
      <div class="wrap"><AppBlock lang={lang} campaign={`site_${lang}_articles`} /></div>
    </section>
  </Base>
)}

{kind === 'app' && (
  <Base lang={lang} title={tr.app.title} description={tr.app.description} page={{ kind }} nav="app">
    <section class="section">
      <div class="wrap">
        <h1>{tr.app.h1}</h1>
        <p class="lead">{tr.app.lead}</p>
        <p class="redirecting muted" hidden>{tr.app.redirecting}</p>
        <StoreButtons lang={lang} campaign={`site_${lang}_app`} />
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <ol class="how">
          {tr.home.how.map((x, i) => <li><span class="num">{i + 1}</span><h2 class="h3">{x.title}</h2><p>{x.text}</p></li>)}
        </ol>
        {screens.length > 0 && (
        <div class="screens">
          {screens.map((s) => (
            <img src={`/img/screens/${lang}/${s}-360.webp`} srcset={`/img/screens/${lang}/${s}-360.webp 360w, /img/screens/${lang}/${s}-720.webp 720w`}
              sizes="(max-width: 600px) 60vw, 220px" width="360" height="779" alt={tr.home.screensAlt} loading="lazy" decoding="async" />
          ))}
        </div>
        )}
      </div>
    </section>
    <script is:inline define:vars={{ redirects }}>
      (function () {
        var c = new URLSearchParams(location.search).get('c');
        var target = redirects[c];
        if (!target) return;
        var ua = navigator.userAgent;
        var android = /Android/i.test(ua);
        var ios = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        if (!android && !ios) return;
        document.querySelector('.redirecting').hidden = false;
        location.replace(android ? target.android : target.ios);
      })();
    </script>
  </Base>
)}

{content && (
  <Base lang={lang} title={content.title} description={content.description} page={{ kind }}>
    <section class="section">
      <div class="wrap prose">
        <h1>{content.h1}</h1>
        <Fragment set:html={content.body} />
      </div>
    </section>
  </Base>
)}

<style>
  .dl { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .more-tools { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .letters { grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); }
  .coloring-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .coloring-grid a { display: grid; gap: 8px; padding: 10px; text-decoration: none; color: inherit; text-align: center; }
  .coloring-grid a:hover { outline: 3px solid var(--ink); outline-offset: 2px; }
  .coloring-grid img { width: 100%; height: auto; border: 1px solid var(--line); }
  .coloring-grid .ph { display: grid; place-items: center; aspect-ratio: 595 / 842; border-radius: 10px; background: var(--c); color: var(--fg); font-size: 3rem; font-weight: 900; }
  .faq { border-bottom: 1px solid var(--line); padding: 12px 0; }
  .faq summary { font-weight: 800; cursor: pointer; }
  .faq p { margin: 8px 0 0; }
  .article-list { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 16px; max-width: 46em; }
  .article-list h2 { margin: 0 0 8px; }
  .article-list p { margin: 0 0 8px; }
  .meta { font-size: 0.95rem; color: var(--muted); }
  .sets { grid-template-columns: 1fr; }
  @media (min-width: 760px) { .sets { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); } }
  .set-letters { display: flex; flex-wrap: wrap; gap: 8px; }
  .set-letters a {
    display: grid; place-items: center; width: 48px; height: 52px; border-radius: 10px;
    background: var(--c); color: var(--fg); font-weight: 900; font-size: 1.5rem; text-decoration: none;
  }
  .set-letters a:hover { outline: 3px solid var(--ink); outline-offset: 2px; }
  .how { list-style: none; padding: 0; margin: 0 0 32px; display: grid; gap: 24px; }
  @media (min-width: 760px) { .how { grid-template-columns: repeat(3, 1fr); } }
  .how p { color: var(--muted); }
  .h3 { font-size: 1.2rem; }
  .num { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: #fff; font-weight: 800; margin-bottom: 12px; }
  .screens { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
  .screens img { flex: none; width: min(60vw, 220px); border-radius: 18px; scroll-snap-align: start; border: 1px solid var(--line); }
</style>
